          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Reuse with the same normalized request after connection loss. Same key with different input returns 409; retained indefinitely."
          }
        ]
      },
