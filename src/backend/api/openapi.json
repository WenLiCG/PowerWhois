              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "description": "Pages are bounded by input count and approximately 8 MiB encoded result bytes. Always follow X-Next-Offset/nextOffset. X-Task-State and X-Export-Consistency describe partial/complete results; active exports are not atomic snapshots."
      }
    },
    "/tasks/{id}/results/{index}": {
      "get": {
        "operationId": "getTaskResult",
        "summary": "Read one completed result including its original response",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State transition or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request rate exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Task storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "A historical result exceeds the safe limit; retrieve summary results instead",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "QueryBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "POWERWHOIS_QUERY_TOKEN; alternatively an administrator JWT for Web. Use HTTPS remotely."
      }
    },
    "schemas": {
      "QueryRequest": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 1000000
          },
          "mode": {
            "type": "string",
            "default": "whois",
            "description": "dns, whois (RDAP preferred), mixed, proxy, original *Query names, or a configured custom query API name"
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "description": "Also bounded by server BulkCheckConcurrencyLimit"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120,
            "default": 30,
            "description": "Overall seconds per domain including retries and limiter waits"
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 0
          }
        },
        "required": [
          "domains"
        ],
        "additionalProperties": false
      },
      "Result": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "registerStatus": {
            "type": "string"
          },
          "lookupType": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "queriedAt": {
            "type": "string"
          },
          "queryError": {
            "type": "string"
          },
          "createdDate": {
            "type": "string"
          },
          "expiryDate": {
            "type": "string"
          },
          "dnsLite": {
            "type": "string"
          },
          "domainStatus": {
            "type": "string"
          },
          "rawResponse": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "viaProxy": {
            "type": "boolean"
          },
          "nameServer": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rawDomainStatus": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "registered",
              "not_found",
              "unknown",
              "timeout",
              "error"
            ]
          },
          "rawResponseAvailable": {
            "type": "boolean",
            "description": "A task summary omitted the raw response; fetch the individual result to read it."
          },
          "rawResponseTruncated": {
            "type": "boolean",
            "description": "Synchronous preview exceeded 64 KiB; use a durable task when complete evidence is required."
          }
        },
        "required": [
          "domain",
          "status",
          "source",
          "queriedAt"
        ],
        "description": "not_found is an upstream absence response, never a promise that a registrar will sell the name. DNS absence is unknown. registerStatus is the legacy Web alias."
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "completed": {
            "type": "integer"
          },
          "concurrency": {
            "type": "integer"
          },
          "timeout": {
            "type": "integer"
          },
          "retries": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "paused",
              "completed",
              "canceled",
              "failed"
            ]
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "parentTaskId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "state",
          "mode",
          "total",
          "completed",
          "counts"
        ]
      },
      "Results": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          },
          "offset": {
            "type": "integer"
          },
          "nextOffset": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "offset",
          "nextOffset",
          "total"
        ],
        "description": "Input-index pagination, not completed-result offsets. nextOffset=-1 ends the snapshot. During execution a page may be empty; after completion rescan from 0 for a complete export."
      },
      "TaskList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "offset": {
            "type": "integer"
          },
          "nextOffset": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "offset",
          "nextOffset"
        ]
      },
      "QueryResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "TypoRequest": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "types": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "enum": [
                "www",
                "skipLetter",
                "doubleLetter",
                "reverseLetter",
                "insertedLetter",
                "wrongHorizontalKey",
                "wrongVerticalKey",
                "customizedReplace"
              ]
            }
          },
          "tlds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          }
        },
        "required": [
          "domain"
        ],
        "additionalProperties": false
      },
      "TypoResponse": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groups": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "domains",
          "groups"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
