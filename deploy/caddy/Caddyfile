{
	admin off
	auto_https off
}

http://:8080 {
	encode zstd gzip

	handle /api/admin/bulkcheckupload {
		request_body {
			max_size 106MB
		}
		reverse_proxy typonamer:8080
	}

	handle /api/* {
		request_body {
			max_size 64KiB
		}
		reverse_proxy typonamer:8080
	}

	handle /app/* {
		reverse_proxy typonamer:8080
	}

	handle {
		root * /typonamer
		try_files {path} /index.html
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=5184000, immutable"
		@index path /index.html
		header @index Cache-Control "no-cache"
		file_server
	}
}
