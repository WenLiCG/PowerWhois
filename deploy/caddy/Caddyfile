{
    admin   off
    auto_https off
}

:8080 {
    encode zstd gzip
    @backend path /healthz /api /api/* /app /app/*
    handle @backend {
        reverse_proxy typonamer:8080
    }

    handle {
        root * /typonamer
        header {
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Referrer-Policy same-origin
        }
        @bundle {
            path /assets/*
            file
        }
        header @bundle Cache-Control "public, max-age=5184000, immutable"
        @page not path_regexp \.[^/]*$
        rewrite @page /index.html
        file_server
    }
}
