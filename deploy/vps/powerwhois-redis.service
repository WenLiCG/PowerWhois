[Unit]
Description=Private Redis for PowerWhois
After=network.target
[Service]
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/powerwhois/redis.conf
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/powerwhois-redis
[Install]
WantedBy=multi-user.target
