[Unit]
Description=PowerWhois query-only MCP HTTP adapter
After=powerwhois.service
Requires=powerwhois.service
[Service]
DynamicUser=yes
StateDirectory=powerwhois-mcp
WorkingDirectory=/var/lib/powerwhois-mcp
EnvironmentFile=/etc/powerwhois/mcp.env
ExecStart=/opt/powerwhois/current/powerwhois-mcp --http 127.0.0.1:8081
Restart=on-failure
RestartSec=5
MemoryMax=256M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
